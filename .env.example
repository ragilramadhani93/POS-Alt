# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pos_alternatif"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="ganti-dengan-string-acak-min-32-karakter"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="ganti-dengan-string-acak-lain-min-32-karakter"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Dashboard
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# Google Sheets (untuk modul GR)
GOOGLE_SERVICE_ACCOUNT_JSON=""   # JSON string service account (opsional, Fase 2)

# Upload (opsional Fase 2)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10
